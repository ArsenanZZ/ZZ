    },
    {
      "kind": "paragraph",
      "html": "<p style=\"margin: 0 0 18px; line-height: 1.95; text-align: justify; font-size: 16px; letter-spacing: 0.2px; color: #26343f; font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;\">不知不觉间发现自己渐渐喜欢上了这所学校和这这群小伙伴。</p>"
    },
