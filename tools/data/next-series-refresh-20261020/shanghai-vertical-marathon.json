    },
    {
      "kind": "paragraph",
      "html": "<p style=\"margin: 0 0 18px; line-height: 1.95; text-align: justify; font-size: 16px; letter-spacing: 0.2px; color: #26343f; font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;\">登上了上海中心，上海也算是没白来了。</p>"
    },
    {
