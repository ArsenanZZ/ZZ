      "height": 3024,
      "sha256": "089c8faf128ac0cf24fe800061ad300bda5e9cf7bb9102d1c62c6e88e8c07f91"
    },
    {
      "kind": "figure",
      "src": "/assets/runcn-liupanshui-2026/Liu-18-1.webp",
      "alt": "完赛了，活动一下腿",
      "caption": "完赛了，活动一下腿",
      "source_file": "Liu-18-1.jpg",
