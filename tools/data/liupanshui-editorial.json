    },
    {
      "kind": "figure",
      "src": "/assets/runcn-liupanshui-2026/Liu-17-5.webp",
      "alt": "终点前，和球迷跑友合个影",
      "caption": "终点前，和球迷跑友合个影",
      "source_file": "Liu-17-5.jpg",
